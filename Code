# ------------------------------------------
# LOAD SAVED PROGRESS
# ------------------------------------------

if os.path.exists(SAVE_FILE):
    print("\nPrevious investigation data found.")
    choice = input("Load previous progress? (yes/no): ").lower()

    if choice == "yes":
        try:
            file = open(SAVE_FILE, "r")
            data = json.load(file)
            file.close()

            score = data.get("score", 0)
            xp = data.get("xp", 0)
            level = data.get("level", 1)
            completed_cases = data.get("completed_cases", [])
            evidence_locker = data.get("evidence_locker", [])
            investigation_reports = data.get("reports", [])

            print("Previous progress loaded!")
        except:
            print("Save file could not be loaded. Starting new investigation.")

# ------------------------------------------
# MAIN COMMAND CENTRE
# ------------------------------------------

while True:

    print("\n" + "=" * 55)
    print("             CYBER DETECTIVE")
    print("             DIGITAL FORENSICS LAB")
    print("=" * 55)

    print("Investigator:", player_name)
    print("Level:", level)
    print("XP:", xp)
    print("Score:", score)
    print("Completed cases:", len(completed_cases), "/ 5")

    print("\n[1] Open Investigation Board")
    print("[2] Evidence Locker")
    print("[3] Investigator Profile")
    print("[4] Investigation Reports")
    print("[5] Save Progress")
    print("[6] Help and Cybersecurity Guide")
    print("[7] Exit Laboratory")

    main_choice = input("\nEnter command: ")

    # ======================================
    # INVESTIGATION BOARD
    # ======================================

    if main_choice == "1":

        while True:
            print("\n========== INVESTIGATION BOARD ==========")

            for case_id, case in cases.items():

                status = "COMPLETED" if case_id in completed_cases else "OPEN"

                print("\nCase ID:", case_id)
                print("Name:", case["name"])
                print("Severity:", case["severity"])
                print("Status:", status)

            print("\n[0] Return to Command Centre")

            case_choice = input("\nSelect case ID: ")

            if not case_choice.isdigit():
                print("Invalid case selection.")
                continue

            case_id = int(case_choice)

            if case_id == 0:
                break

            if case_id not in cases:
                print("Case does not exist.")
                continue

            case = cases[case_id]

            if case_id in completed_cases:
                print("This investigation has already been completed.")
                continue

            case_score = 0
            collected_clues = []
            examined_logs = False
            analysis_complete = False

            # ----------------------------------
            # CASE INVESTIGATION MENU
            # ----------------------------------

            while True:

                print("\n" + "-" * 45)
                print("CASE:", case["name"])
                print("Victim:", case["victim"])
                print("Severity:", case["severity"])
                print("-" * 45)

                print("[1] Read Case Description")
                print("[2] Examine Server Logs")
                print("[3] View Investigation Clues")
                print("[4] Collect Digital Evidence")
                print("[5] Analyze Suspicious IP")
                print("[6] Submit Investigation")
                print("[0] Leave Case")

                action = input("\nChoose investigation action: ")

                # ----------------------------------
                # CASE DESCRIPTION
                # ----------------------------------

                if action == "1":
                    print("\nCASE DESCRIPTION")
                    print(case["description"])
                    print("Organization:", case["victim"])

                # ----------------------------------
                # SERVER LOG ANALYSIS
                # ----------------------------------

                elif action == "2":

                    print("\n========== SERVER LOG ANALYZER ==========")

                    for log in case["logs"]:
                        print(log)

                    examined_logs = True
                    case_score += 10

                    print("\nLog examination completed.")
                    print("Remember: alerts are clues, not automatic proof.")

                # ----------------------------------
                # INVESTIGATION CLUES
                # ----------------------------------

                elif action == "3":

                    print("\n========== INVESTIGATION CLUES ==========")

                    for clue_number, clue in enumerate(case["clues"], 1):
                        print(str(clue_number) + ".", clue)

                    collected_clues = list(case["clues"])

                # ----------------------------------
                # EVIDENCE COLLECTION
                # ----------------------------------

                elif action == "4":

                    print("\n========== DIGITAL EVIDENCE ==========")

                    if not examined_logs:
                        print("Examine the logs before collecting evidence.")
                    else:

                        evidence = (
                            "Case " + str(case_id) +
                            ": " + case["name"] +
                            " - Server logs examined"
                        )

                        if evidence not in evidence_locker:
                            evidence_locker.append(evidence)
                            case_score += 15
                            print("Evidence successfully collected!")
                        else:
                            print("This evidence is already in your locker.")

                        print("Evidence:", evidence)

                # ----------------------------------
                # SUSPICIOUS IP ANALYSIS
                # ----------------------------------

                elif action == "5":

                    print("\n========== IP INVESTIGATION ==========")

                    print("Fictional IP addresses associated with this case:")

                    for number, ip in enumerate(case["suspects"], 1):
                        print(number, "-", ip)

                    selected_ip = input("\nEnter IP to examine: ").strip()

                    if selected_ip not in case["suspects"]:
                        print("This IP is not listed in the case records.")

                    elif selected_ip == case["correct_ip"]:
                        print("\nThe selected address matches the case's primary indicator.")
                        print("Remember: this is a fictional simulation.")
                        case_score += 20
                        analysis_complete = True

                    else:
                        print("\nThis address is not the primary indicator.")
                        print("Review the server logs and clues.")

                # ----------------------------------
                # SUBMIT INVESTIGATION
                # ----------------------------------

                elif action == "6":

                    if not examined_logs:
                        print("You must examine the server logs first.")
                        continue

                    if not analysis_complete:
                        print("Analyze the primary IP indicator first.")
                        continue

                    print("\n========== FINAL INVESTIGATION ==========")

                    print("CASE:", case["name"])
                    print("Victim:", case["victim"])
                    print("Severity:", case["severity"])

                    print("\nWhat do you think happened?")
                    print(case["answer"])

                    print("\nRecommended defensive response:")
                    print(case["recommendation"])

                    print("\nInvestigation score:", case_score)

                    confidence = input(
                        "\nDo you agree with the investigation findings? (yes/no): "
                    ).lower()

                    if confidence == "yes":

                        completed_cases.append(case_id)
                        score += case_score + 25
                        xp += 100

                        if xp >= level * 200:
                            level += 1
                            print("\nLEVEL UP!")
                            print("New investigator level:", level)

                        report = {
                            "case_id": case_id,
                            "case_name": case["name"],
                            "victim": case["victim"],
                            "severity": case["severity"],
                            "result": "Investigation completed",
                            "date": datetime.now().strftime("%Y-%m-%d %H:%M")
                        }

                        investigation_reports.append(report)

                        print("\nCASE SUCCESSFULLY CLOSED!")
                        print("XP earned: 100")
                        print("Bonus score: 25")

                        break

                    else:
                        print("Investigation remains open.")
                        print("Review the clues and findings.")

                elif action == "0":
                    print("Leaving investigation.")
                    break

                else:
                    print("Invalid command.")

    # ======================================
    # EVIDENCE LOCKER
    # ======================================

    elif main_choice == "2":

        print("\n========== DIGITAL EVIDENCE LOCKER ==========")

        if len(evidence_locker) == 0:
            print("No evidence collected yet.")

        else:
