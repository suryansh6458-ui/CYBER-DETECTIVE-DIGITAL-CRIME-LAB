                print("Victim:", report["victim"])
                print("Severity:", report["severity"])
                print("Result:", report["result"])
                print("Date:", report["date"])
                print("-" * 40)

    # ======================================
    # SAVE PROGRESS
    # ======================================

    elif main_choice == "5":

        data = {
            "score": score,
            "xp": xp,
            "level": level,
            "completed_cases": completed_cases,
            "evidence_locker": evidence_locker,
            "reports": investigation_reports
