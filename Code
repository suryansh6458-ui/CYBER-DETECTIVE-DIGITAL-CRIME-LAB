    # HELP SECTION
    # ======================================

    elif main_choice == "6":

        print("\n========== CYBERSECURITY GUIDE ==========")

        print("""
1. SERVER LOGS
   Records of events occurring on a computer system.

2. IP ADDRESS
   An address used to identify a device on a network.

3. DIGITAL EVIDENCE
   Information that may help explain a security incident.

4. PHISHING
   A deceptive attempt to obtain sensitive information.

5. MALWARE
   Software designed to perform unwanted or harmful actions.

6. INCIDENT RESPONSE
   The process of identifying, investigating and responding
   to a cybersecurity incident.

IMPORTANT:
This project uses fictional data and simulated investigations.
It does not connect to real systems or investigate real people.
""")

    # ======================================
    # EXIT
    # ======================================

    elif main_choice == "7":

        print("\nBefore exiting, save your progress if needed.")
        confirm = input("Exit the laboratory? (yes/no): ").lower()

        if confirm == "yes":
            print("\nInvestigator", player_name, "signed out.")
            print("Final score:", score)
            print("Cases completed:", len(completed_cases))
            print("Thanks for playing CYBER DETECTIVE!")
            break

    else:
        print("Invalid command. Try again.")
